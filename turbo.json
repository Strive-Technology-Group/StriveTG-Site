{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PLAYWRIGHT_BASE_URL",
    "CI",
    "LEAD_INTAKE_ENABLED",
    "LEAD_INTAKE_OPERATIONS_APPROVED",
    "LEAD_PROVIDER",
    "LEAD_NOTIFICATION_EMAIL",
    "LEAD_INTAKE_ALLOW_INSECURE_LOCALHOST",
    "LEAD_PROVIDER_ATTEMPTS",
    "LEAD_PROVIDER_TIMEOUT_MS",
    "LEAD_RETENTION_DAYS",
    "HUBSPOT_API_BASE_URL",
    "HUBSPOT_ACCESS_TOKEN",
    "HUBSPOT_PIPELINE_ID",
    "HUBSPOT_NEW_INQUIRY_STAGE_ID",
    "HUBSPOT_OWNER_ID",
    "HUBSPOT_PORTAL_ID",
    "HUBSPOT_REFERENCE_PROPERTY",
    "HUBSPOT_SERVICE_PROPERTY",
    "HUBSPOT_PROJECT_GOAL_PROPERTY",
    "HUBSPOT_TIMING_PROPERTY",
    "HUBSPOT_INVESTMENT_PROPERTY",
    "HUBSPOT_CONTACT_METHOD_PROPERTY",
    "HUBSPOT_SOURCE_PROPERTY",
    "HUBSPOT_SUBMITTED_AT_PROPERTY",
    "HUBSPOT_SYSTEMS_PROPERTY",
    "HUBSPOT_ORIGINAL_BRIEF_PROPERTY",
    "HUBSPOT_NOTIFICATION_STATUS_PROPERTY",
    "HUBSPOT_RETENTION_REVIEW_PROPERTY",
    "RESEND_API_BASE_URL",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RESEND_REPLY_TO_EMAIL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

# Fail closed until the owner completes LEAD_INTAKE_SETUP.md and approves launch.
# Canonical metadata is emitted from app/lib/company.ts as
# https://www.strivetg.com. The apex-to-www redirect belongs to verified
# production DNS/hosting configuration and is not enabled by an environment flag.
LEAD_INTAKE_ENABLED=false
LEAD_INTAKE_OPERATIONS_APPROVED=false
LEAD_PROVIDER=hubspot

# Request reliability and the approved retention-review interval.
LEAD_PROVIDER_ATTEMPTS=3
LEAD_PROVIDER_TIMEOUT_MS=5000
LEAD_RETENTION_DAYS=365
LEAD_NOTIFICATION_EMAIL=

# HubSpot private-app and destination identifiers (server only).
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_NEW_INQUIRY_STAGE_ID=
HUBSPOT_OWNER_ID=
HUBSPOT_PORTAL_ID=

# HubSpot internal names for the custom deal properties in the setup guide.
HUBSPOT_REFERENCE_PROPERTY=strive_reference
HUBSPOT_SERVICE_PROPERTY=strive_service_needed
HUBSPOT_PROJECT_GOAL_PROPERTY=strive_project_goal
HUBSPOT_TIMING_PROPERTY=strive_desired_timing
HUBSPOT_INVESTMENT_PROPERTY=strive_expected_investment
HUBSPOT_CONTACT_METHOD_PROPERTY=strive_preferred_contact
HUBSPOT_SOURCE_PROPERTY=strive_source_page
HUBSPOT_SUBMITTED_AT_PROPERTY=strive_submitted_at
HUBSPOT_SYSTEMS_PROPERTY=strive_existing_systems
HUBSPOT_ORIGINAL_BRIEF_PROPERTY=strive_original_brief
HUBSPOT_NOTIFICATION_STATUS_PROPERTY=strive_notification_status
HUBSPOT_RETENTION_REVIEW_PROPERTY=strive_retention_review

# Resend transaction-email settings (server only). Use a verified sender domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# Tests may override these with an explicitly permitted local mock. Production
# should use the secure defaults and must never enable insecure localhost access.
# HUBSPOT_API_BASE_URL=https://api.hubapi.com
# RESEND_API_BASE_URL=https://api.resend.com
# LEAD_INTAKE_ALLOW_INSECURE_LOCALHOST=false
